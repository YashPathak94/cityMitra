# AI chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# AI card images (optional) - when OPENAI_API_KEY is set, card photos are
# generated to match the card name + city and cached. Override the image model
# if needed. Persistent cache uses Supabase: create this table once -
#   create table public.image_cache (
#     cache_key text primary key,
#     mime text,
#     data text,
#     created_at timestamptz default now()
#   );
#   grant all privileges on table public.image_cache to service_role;
# Without OPENAI_API_KEY the cards use the matched theme photos (no change).
OPENAI_IMAGE_MODEL=gpt-image-1

# Admin (REQUIRED in production - admin login fails closed without them)
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# SEO / site identity
NEXT_PUBLIC_SITE_URL=https://citymitra.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles shown in the footer
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_WHATSAPP=

# Durable storage (required on Vercel - serverless filesystem is read-only)
# Create a free Supabase project, run the SQL in DEPLOYMENT.md, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CityMitra Pro payments (Razorpay) — required to take Pro payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_PRO_PRICE_INR=199

# Affiliate IDs for the booking concierge (optional, append as query strings)
# e.g. NEXT_PUBLIC_AFFILIATE_BOOKING=aid=1234567
NEXT_PUBLIC_AFFILIATE_BOOKING=
NEXT_PUBLIC_AFFILIATE_AGODA=
NEXT_PUBLIC_AFFILIATE_MAKEMYTRIP=
NEXT_PUBLIC_AFFILIATE_SKYSCANNER=
NEXT_PUBLIC_AFFILIATE_ZOMATO=

# CityMitra Pro accounts (login/signup) - required to enable accounts
AUTH_SESSION_SECRET=

# Google sign-in (optional) - create OAuth creds in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=

# Password reset email (optional) - Resend
RESEND_API_KEY=
EMAIL_FROM=

# CityMitra Pro subscriptions (auto-renewal) - create a monthly Plan in Razorpay
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
