# AI chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Admin (REQUIRED in production - admin login fails closed without them)
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# SEO / site identity
NEXT_PUBLIC_SITE_URL=https://citymitra.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles shown in the footer
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_WHATSAPP=

# Durable storage (required on Vercel - serverless filesystem is read-only)
# Create a free Supabase project, run the SQL in DEPLOYMENT.md, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
